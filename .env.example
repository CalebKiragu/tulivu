# ---------------------------------------------------------------------------
# Tulivu environment example
#
# Copy to .env for local development. Every value below is optional except
# SESSION_SECRET in production. Defaults use the mock model, mock imagery,
# mock research, the demo ad adapter and embedded PGlite, so no paid keys are
# needed to run and test the full loop.
# ---------------------------------------------------------------------------

# ------------------------------- runtime -----------------------------------
NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Public origin of the deployed app. Reserved for absolute links in future
# integrations; the demo currently uses relative URLs.
PUBLIC_BASE_URL=http://localhost:8787

# Signs the demo session cookie. Generate with:
#   openssl rand -hex 32
# Required when NODE_ENV=production. A development fallback exists, but never
# deploy with it.
SESSION_SECRET=

# Requests per minute per client IP. 120 is generous for a demo.
RATE_LIMIT_MAX=120

# ----------------------------- persistence ---------------------------------
# Leave DATABASE_URL empty to use embedded PGlite (local development/tests).
# Example: postgres://user:password@host:5432/tulivu
DATABASE_URL=
# Set true when the PostgreSQL provider requires TLS (for example a managed
# database reached over the public internet).
PGSSL=false

# PGlite and asset paths. Only used when DATABASE_URL is empty.
DATA_DIR=./var
PGLITE_DIR=./var/pglite
ASSETS_DIR=./var/assets

# ------------------------------- workflow ----------------------------------
# false runs the eight stages in the background; true runs them inline.
# Tests force true. Keep false for a responsive local demo.
WORKFLOW_INLINE=false

# demo: create deterministic, paused simulated resources. No network calls.
# live: intentionally unimplemented; the Meta/Google adapters throw
#       PlatformNotConfiguredError until real credentials and code exist.
ADAPTER_MODE=demo

# Development-only fault injection for exercising partial execution failure.
DEMO_FAIL_EXECUTION=false

# -------------------------------- models -----------------------------------
# mock: deterministic, template-based provider. No API key, no LLM calls.
# openai-compatible: any /chat/completions endpoint that supports JSON mode.
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=mock-tulivu-1
MODEL_TIMEOUT_MS=45000
MODEL_MAX_OUTPUT_TOKENS=2200
MODEL_TEMPERATURE=0.4

# Optional task profiles. Each falls back to MODEL_NAME when unset. Point
# structured extraction and fast utility work at cheaper/faster models, and
# keep strategy/quality on a stronger one.
# MODEL_PLANNING=
# MODEL_COPYWRITING=
# MODEL_STRUCTURED_EXTRACTION=
# MODEL_CREATIVE_DIRECTION=
# MODEL_QUALITY_REVIEW=
# MODEL_FAST_UTILITY=

# -------------------------------- imagery ----------------------------------
# mock: deterministic SVG placeholders marked "MOCK VISUAL".
# openai-compatible: POST {IMAGE_BASE_URL}/images/generations.
IMAGE_PROVIDER=mock
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_TIMEOUT_MS=60000

# ------------------------------- research ----------------------------------
# mock: no external research; audience output is explicitly hypothesis-based.
# tavily: optional live search. Requires TAVILY_API_KEY.
WEB_RESEARCH_PROVIDER=mock
TAVILY_API_KEY=
WEB_RESEARCH_TIMEOUT_MS=20000
